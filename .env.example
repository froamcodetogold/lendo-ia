# Banco de dados (Supabase Postgres). O Prisma CLI só lê .env, não .env.local.
DATABASE_URL="postgresql://postgres:senha@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:senha@host:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"

# OAuth — console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — sem chave a busca funciona com limite de requisições mais baixo.
# Mesmo projeto do Google Cloud, ativando a "Books API".
GOOGLE_BOOKS_API_KEY=

# Protege /api/cron/weekly-reset. Gere com: openssl rand -hex 24
CRON_SECRET=
